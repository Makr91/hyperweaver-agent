[Unit]
Description=Hyperweaver Agent - VirtualBox/Vagrant host-agent (headless)
After=network.target
Wants=network.target

[Service]
Type=simple
User=hyperweaver-agent
Group=hyperweaver-agent
WorkingDirectory=/var/lib/hyperweaver-agent
ExecStart=/usr/bin/hyperweaver-agent --headless --config /etc/hyperweaver-agent
Restart=always
RestartSec=3

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ConfigurationDirectory=hyperweaver-agent
ConfigurationDirectoryMode=0750
ReadWritePaths=/etc/hyperweaver-agent /var/lib/hyperweaver-agent /var/log/hyperweaver-agent

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hyperweaver-agent

[Install]
WantedBy=multi-user.target
